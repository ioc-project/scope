# failure-detection-worker environment template. Copy to .env: cp .env.template .env

# Neo4j (the KG, with the symbolic state written by the extractor)
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/change-me
NEO4J_DB=neo4j

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Queues (optional, defaults shown)
FAILURE_DETECTION_INPUT_QUEUE=new_session_to_failure_detection
# FAILURE_DETECTION_OUTPUT_QUEUE=

# Which failure codes to report (optional, comma-separated; default: all)
# FAILURE_DETECTION_FAILURES=CE-1,DR-2

FAILURE_DETECTION_MAX_INFLIGHT_MESSAGES=4
