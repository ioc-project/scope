# symbolic-extractor-worker environment template. Copy to .env: cp .env.template .env

# Neo4j (the KG: read the session, write the symbolic state)
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/change-me
NEO4J_DB=neo4j

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# LLM (OpenAI-compatible endpoint, with JSON mode)
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

# Embeddings for same_claims (same OpenAI-compatible endpoint as the LLM)
EMBEDDING_MODEL_NAME=azure/text-embedding-3-small
# SYMBOLIC_EXTRACTOR_NO_SAME_CLAIMS=1   # skip the embedding comparison

# Queues (optional, defaults shown)
SYMBOLIC_EXTRACTOR_INPUT_QUEUE=new_session_to_symbolic_extractor
SYMBOLIC_EXTRACTOR_OUTPUT_QUEUE=new_session_to_failure_detection

SYMBOLIC_EXTRACTOR_MAX_INFLIGHT_MESSAGES=2
