# Copy to .env before running: cp .env.template .env
# Defaults mirror k8s/charts/scope/values.yaml. Change the passwords before sharing the deployment.

# --- Images -----------------------------------------------------------------
# Tag defaults to the chart appVersion. `docker compose up --build` builds the images from this
# checkout instead of pulling them.
SCOPE_VERSION=1.0.2
SCOPE_IMAGE_REGISTRY=ghcr.io/ioc-project/container-images

# --- LLM (required) ----------------------------------------------------------
# Mirrors secrets.llm in the chart.
LLM_MODEL_NAME=gpt-4o                               # or azure/gpt-4o for Azure
EMBEDDING_MODEL_NAME=azure/text-embedding-3-small
LLM_GATEWAY_BASE_URL=https://api.openai.com/v1      # omit for Azure
LLM_GATEWAY_API_KEY=

# --- Credentials -------------------------------------------------------------
CLICKHOUSE_USERNAME=scope
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=default
RABBITMQ_USERNAME=scope
RABBITMQ_PASSWORD=change-me
NEO4J_PASSWORD=change-me

# --- Workers -------------------------------------------------------------------
# The embedding worker feeds these queues. The cognitive-failure worker makes a judge-model call for each session,
# and the cognition-protocols worker is built with an SSH agent that can read the private protocol packages.
# To turn one off, remove its queue here and stop its service (docker compose stop <service>).
# EMBEDDING_OUTPUT_QUEUE=new_session_to_grouping,new_session_to_stateful_eval,new_session_to_cognitive_failure,new_session_to_cognition_protocols

# --- Published ports ---------------------------------------------------------
SCOPE_PORT=8080            # gateway: UI + API
OTLP_GRPC_PORT=4317        # otel collector, point your instrumented apps here
OTLP_HTTP_PORT=4318
# Infrastructure ports, published on 127.0.0.1 only.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- UI feature flags (ui.featureFlags in the chart) --------------------------
FF_SEMANTIC_GROUPS=true
FF_INSIGHTS=true
FF_LIVE_TOPOLOGY=true
FF_STATEFUL_EVAL=true
FF_IMPACT_ASSESSMENT=false
FF_WASTE_ESTIMATION=false
FF_NEUROSYMBOLIC_EVAL=false
FF_COGNITIVE_OBSERVABILITY=false
FF_COGNITION_PROTOCOLS=false
