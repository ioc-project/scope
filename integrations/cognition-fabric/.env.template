# Minimal environment template for Docker Compose worker queue mode
# Copy to .env before running: cp .env.template .env

# Core infrastructure
# Workers build the AMQP URL from these values; the host and port are set in
# docker-compose.yml and point at the bundled broker.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest # legit:ignore
# Optional: point workers at an external broker instead of the bundled one.
# Takes precedence over the values above and the host/port in the compose file.
# RABBITMQ_URL=

# Optional LLM settings for on-demand metrics in the Cognition Fabric API.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-llm-gateway.example/v1

AI_GATEWAY_API_KEY=
LLM_MODEL_NAME=gpt-4o          # or azure/gpt-4o for Azure
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1   # for non-Azure OpenAI; omit for Azure

# ClickHouse (external to this Compose stack)
CLICKHOUSE_HOST=host.docker.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin # legit:ignore
CLICKHOUSE_DATABASE=default

# Cognition Store (external Postgres, or use the cognition-store.yml overlay)
# POSTGRES_URL=
# POSTGRES_PASSWORD=

# Neo4j
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/testpassword # legit:ignore
