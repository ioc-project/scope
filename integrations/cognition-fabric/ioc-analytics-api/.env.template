# Environment template for root docker-compose worker stack
# Copy to .env before running: cp .env.template .env

# Core infrastructure
RABBITMQ_USER=guest 
RABBITMQ_PASSWORD=guest

# Private package registry credentials (required for uv sync in Docker builds)
ARTIFACTORY_USERNAME=
ARTIFACTORY_PASSWORD=

# Neo4j
NEO4J_PASSWORD=testpassword # legit:ignore

# Shared worker settings
EMBEDDING_MODEL=azure/text-embedding-3-small

# Queue wiring for analysis pipeline
ANALYSIS_INPUT_QUEUE=new_session_to_analysis

# Analysis worker tuning
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_CONCURRENCY=12

# Optional analysis layer config files (inside container paths or mounted files)
ANOMALY_CONFIG_FILE=
CONSISTENCY_CONFIG_FILE=
NORMAL_BEHAVIOUR_CONFIG_FILE=

# OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
LLM_MODEL_NAME=gpt-4o          # or azure/gpt-4o for Azure
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1   # for non-Azure OpenAI; omit for Azure

# Clickhouse (used directly by norm/embedding/other workers via oxp API layer)
CLICKHOUSE_HOST=host.docker.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin

# Worker throughput tuning
NORM_MAX_INFLIGHT_MESSAGES=64
EMBEDDING_MAX_INFLIGHT_MESSAGES=16
MCE_MAX_INFLIGHT_MESSAGES=16
GROUPING_MAX_INFLIGHT_MESSAGES=16
ANALYSIS_MAX_INFLIGHT_MESSAGES=3
HIERARCHICAL_GROUPING_MAX_INFLIGHT_MESSAGES=1
INTELLIGENCE_MAX_INFLIGHT_MESSAGES=1
DECISION_BLOCK_MAX_INFLIGHT_MESSAGES=8
STATEFUL_EVAL_MAX_INFLIGHT_MESSAGES=8
NSEVAL_MAX_INFLIGHT_MESSAGES=8

# Queue wiring
EMBEDDING_OUTPUT_QUEUE=new_session_to_grouping,new_session_embedding_to_decision_block
DB_INPUT_QUEUE=new_session_embedding_to_decision_block
DB_NSEVAL_OUTPUT_Q=new_session_to_nseval
DB_STATEFUL_OUTPUT_Q=new_session_to_stateful_eval
STATEFUL_EVAL_INPUT_QUEUE=new_session_to_stateful_eval
NSEVAL_INPUT_QUEUE=new_session_to_nseval

# Optional analysis config files
ANOMALY_CONFIG_FILE=
CONSISTENCY_CONFIG_FILE=
NORMAL_BEHAVIOUR_CONFIG_FILE=

# Intelligence scheduling
INTELLIGENCE_PERIODIC_TRIGGER_INTERVAL_SECONDS=600

# LLM/API credentials
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# MLflow endpoint consumed by workers
MLFLOW_HOST=mlflow
MLFLOW_PORT=5000

# Optional mlflow profile services
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123 # legit:ignore
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_BUCKET_NAME=mlflow-artifacts

# Optional compatibility variables used by local scripts
ANALYSIS_INPUT_QUEUE=new_session_to_analysis
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_CONCURRENCY=12
LLM_MODEL_NAME=gpt-4o
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1
NEO4J_AUTH=neo4j/testpassword # legit:ignore